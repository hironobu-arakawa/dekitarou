---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import CaseLayout from "../../layouts/Case.astro";
import ResponsibilityBoundary from "../../components/ResponsibilityBoundary.astro";
import SiteConcerns from "../../components/SiteConcerns.astro";

export async function getStaticPaths() {
  const cases = await getCollection("cases");
  return cases.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"cases">;
}

const { entry } = Astro.props;

const html = entry.rendered?.html ?? "";

// 固定見出しのセクション冒頭(見出しと、直後に導入段落があればその後)に、
// frontmatterから描画する図・表を差し込む。
// 見出しが無い場合はビルドを落とす(12セクションは固定)。
function splitAfterHeading(source: string, heading: string): [string, string] {
  const marker = source.match(new RegExp(`<h2[^>]*>${heading}</h2>`));
  if (!marker || marker.index === undefined) {
    throw new Error(
      `案件カード "${entry.data.slug}" に「## ${heading}」見出しがありません。12セクションは固定です。`,
    );
  }
  let cut = marker.index + marker[0].length;
  const lead = source.slice(cut).match(/^\s*<p>[\s\S]*?<\/p>/);
  if (lead) cut += lead[0].length;
  return [source.slice(0, cut), source.slice(cut)];
}

const [htmlBeforeBoundary, htmlRest] = splitAfterHeading(html, "責任分界図");
const [htmlBeforeConcerns, htmlAfter] = splitAfterHeading(htmlRest, "現場の管理点との擦り合わせ");

const headings = (entry.rendered?.metadata?.headings ?? []) as {
  depth: number;
  slug: string;
  text: string;
}[];
---

<CaseLayout data={entry.data} headings={headings}>
  <Fragment set:html={htmlBeforeBoundary} />
  <ResponsibilityBoundary boundaries={entry.data.boundaries} />
  <Fragment set:html={htmlBeforeConcerns} />
  <SiteConcerns concerns={entry.data.concerns} />
  <Fragment set:html={htmlAfter} />
</CaseLayout>
