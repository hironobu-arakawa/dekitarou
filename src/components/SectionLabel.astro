---
/**
 * 和英併記のセクション見出し。図面の表題欄の様式(specs.md 改訂記録 2026-09-12)。
 * 「このサイトは翻訳する場所」であることをUIの様式で示す。
 */
interface Props {
  jp: string;
  en: string;
  id?: string;
}

const { jp, en, id } = Astro.props;
---

<h2 class="sl" id={id}>
  <span class="sl-jp">{jp}</span>
  <span class="sl-en" aria-hidden="true">{en}</span>
</h2>

<style>
  .sl {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-xl);
    border-top: var(--border-boundary);
    padding-top: var(--space-4);
    margin: 0 0 var(--space-2);
  }
  .sl-en {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.18em;
    color: var(--color-ink-muted);
  }
</style>
