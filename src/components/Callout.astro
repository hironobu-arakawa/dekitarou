---
/**
 * 警告・注意用の囲み (specs.md §7)。
 * type="warning" は撤退基準・安全に関わる注意に使う。
 */
interface Props {
  type?: "info" | "warning";
  title?: string;
}

const { type = "info", title } = Astro.props;
---

<aside class={`callout callout-${type}`} role="note">
  {title && <p class="callout-title">{title}</p>}
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: var(--space-6) 0;
    padding: var(--space-3) var(--space-4);
    border: var(--border-hairline);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }
  .callout-info {
    border-left: 4px solid var(--color-owner-contractor);
  }
  .callout-warning {
    border-left: 4px solid var(--color-warning);
    background: var(--color-owner-shared-bg);
  }
  .callout-title {
    margin: 0 0 var(--space-2);
    font-weight: 700;
  }
  .callout-warning .callout-title {
    color: var(--color-warning);
  }
  .callout-body :global(p:first-child) {
    margin-top: 0;
  }
  .callout-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
